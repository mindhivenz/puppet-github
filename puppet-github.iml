  </component>
  <component name="RakeTasksCache">
    <option name="myRootTask">
      <RakeTaskImpl id="rake">
        <subtasks>
          <RakeTaskImpl description="Run beaker acceptance tests" fullCommand="beaker" id="beaker" />
          <RakeTaskImpl id="beaker">
            <subtasks>
              <RakeTaskImpl description="List available beaker nodesets" fullCommand="beaker:sets" id="sets" />
              <RakeTaskImpl description="Try to use vagrant to login to the Beaker node" fullCommand="beaker:ssh[set,node]" id="ssh[set,node]" />
              <RakeTaskImpl description="" fullCommand="beaker:ssh" id="ssh" />
            </subtasks>
          </RakeTaskImpl>
          <RakeTaskImpl description="Build puppet module package" fullCommand="build" id="build" />
          <RakeTaskImpl id="build">
            <subtasks>
              <RakeTaskImpl description="Build Puppet module with PDK" fullCommand="build:pdk" id="pdk" />
              <RakeTaskImpl description="Build Puppet module package with PMT (Puppet &lt; 6.0.0 only)" fullCommand="build:pmt" id="pmt" />
            </subtasks>
          </RakeTaskImpl>
          <RakeTaskImpl description="Generate a Changelog from GitHub" fullCommand="changelog" id="changelog" />
          <RakeTaskImpl description="Run static pre release checks" fullCommand="check" id="check" />
          <RakeTaskImpl id="check">
            <subtasks>
              <RakeTaskImpl description="Fails if any ._ files are present in directory" fullCommand="check:dot_underscore" id="dot_underscore" />
              <RakeTaskImpl description="Fails if directories contain the files specified in .gitignore" fullCommand="check:git_ignore" id="git_ignore" />
              <RakeTaskImpl description="Fails if symlinks are present in directory" fullCommand="check:symlinks" id="symlinks" />
              <RakeTaskImpl description="Fails if .pp files present in tests folder" fullCommand="check:test_file" id="test_file" />
            </subtasks>
          </RakeTaskImpl>
          <RakeTaskImpl description="Clean a built module package" fullCommand="clean" id="clean" />
          <RakeTaskImpl description="Print development version of module" fullCommand="compute_dev_version" id="compute_dev_version" />
          <RakeTaskImpl description="Display the list of available rake tasks" fullCommand="help" id="help" />
          <RakeTaskImpl description="Run puppet-lint" fullCommand="lint" id="lint" />
          <RakeTaskImpl description="Run puppet-lint" fullCommand="lint_fix" id="lint_fix" />
          <RakeTaskImpl id="litmus">
            <subtasks>
              <RakeTaskImpl id="acceptance">
                <subtasks>
                  <RakeTaskImpl description="Run serverspec against localhost, USE WITH CAUTION, this action can be potentially dangerous" fullCommand="litmus:acceptance:localhost[tag]" id="localhost[tag]" />
                  <RakeTaskImpl description="" fullCommand="litmus:acceptance:localhost" id="localhost" />
                </subtasks>
              </RakeTaskImpl>
              <RakeTaskImpl description="add a feature tag to a node" fullCommand="litmus:add_feature[added_feature,target_node_name]" id="add_feature[added_feature,target_node_name]" />
              <RakeTaskImpl description="check the connectivity to all provisioned targets" fullCommand="litmus:check_connectivity[target_node_name]" id="check_connectivity[target_node_name]" />
              <RakeTaskImpl description="install a puppet agent to all or a specified set of targets" fullCommand="litmus:install_agent[collection,target_node_name]" id="install_agent[collection,target_node_name]" />
              <RakeTaskImpl description="build the module under test and install it onto targets" fullCommand="litmus:install_module[target_node_name,module_repository]" id="install_module[target_node_name,module_repository]" />
